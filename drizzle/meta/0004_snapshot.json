      "checkConstraints": {
        "goal_operations_kind_valid": {
          "name": "goal_operations_kind_valid",
          "value": "\"savings_goal_operations\".\"kind\" IN ('fund','release','transfer','archive','restore','close','reclassify','reverse')"
        },
        "goal_operations_amount_valid": {
          "name": "goal_operations_amount_valid",
          "value": "\n    CASE WHEN \"savings_goal_operations\".\"kind\" IN ('fund','release','transfer','reclassify')\n      THEN \"savings_goal_operations\".\"amount\" IS NOT NULL AND \"savings_goal_operations\".\"amount\" > 0\n      WHEN \"savings_goal_operations\".\"kind\" = 'reverse' THEN \"savings_goal_operations\".\"amount\" IS NULL OR \"savings_goal_operations\".\"amount\" > 0\n      ELSE \"savings_goal_operations\".\"amount\" IS NULL END"
        },
        "goal_operations_destination_valid": {
          "name": "goal_operations_destination_valid",
          "value": "\n    CASE WHEN \"savings_goal_operations\".\"kind\" = 'transfer' THEN \"savings_goal_operations\".\"destination_goal_id\" IS NOT NULL AND \"savings_goal_operations\".\"destination_goal_id\" <> \"savings_goal_operations\".\"goal_id\"\n      WHEN \"savings_goal_operations\".\"kind\" = 'reverse' THEN \"savings_goal_operations\".\"destination_goal_id\" IS NULL OR \"savings_goal_operations\".\"destination_goal_id\" <> \"savings_goal_operations\".\"goal_id\"\n      ELSE \"savings_goal_operations\".\"destination_goal_id\" IS NULL END"
        },
        "goal_operations_original_valid": {
          "name": "goal_operations_original_valid",
          "value": "(\"savings_goal_operations\".\"kind\" = 'reverse') = (\"savings_goal_operations\".\"original_operation_id\" IS NOT NULL) AND \"savings_goal_operations\".\"original_operation_id\" IS DISTINCT FROM \"savings_goal_operations\".\"operation_id\""
        },
        "goal_operations_legacy_valid": {
          "name": "goal_operations_legacy_valid",
          "value": "(\"savings_goal_operations\".\"kind\" = 'reclassify') = (\"savings_goal_operations\".\"legacy_contribution_id\" IS NOT NULL)"
        }
      },
      "isRLSEnabled": false
    },
